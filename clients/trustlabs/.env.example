# Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX)
VITE_GA_ID=

# Formspree form ID for the Booking form (from https://formspree.io — form endpoint https://formspree.io/f/<ID>)
VITE_FORMSPREE_ID=

# Supabase project (Settings → API in the Supabase dashboard)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Online Visa payment through Paymob. Set to "true" ONLY after the Paymob Edge Functions
# and secrets are deployed (see supabase/PAYMOB_SETUP.md). Leave empty/false and the
# booking form offers cash only. No Paymob keys belong here — they live in Supabase secrets.
VITE_ONLINE_PAYMENT_ENABLED=
