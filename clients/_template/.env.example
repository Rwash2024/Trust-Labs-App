# Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX)
VITE_GA_ID=

# Formspree form ID for the Booking form (from https://formspree.io — form endpoint https://formspree.io/f/<ID>)
VITE_FORMSPREE_ID=

# Supabase project (Settings → API in the Supabase dashboard)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Paymob payment link for online Visa/card payment on the Booking screen.
# Leave empty until the Paymob merchant account is set up — the Visa option still
# works, it just tells the patient the call center will follow up for payment.
VITE_PAYMOB_LINK=
